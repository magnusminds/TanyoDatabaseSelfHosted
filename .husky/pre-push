#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# --- Branch name guard: feature/ | hotfix/ | bugfix/ + TAN-####-description (long-lived branches pass) ---
BRANCH=$(git rev-parse --abbrev-ref HEAD)
case "$BRANCH" in
  dev|main|master|HEAD) ;;
  *)
    if ! printf '%s' "$BRANCH" | grep -Eq '^(feature|hotfix|bugfix)/TAN-[0-9]+(-[A-Za-z0-9._-]+)?$'; then
      echo ""
      echo "  ERROR: Invalid branch name: \"$BRANCH\""
      echo ""
      echo "  Required:  feature/TAN-####[-short-description]"
      echo "             hotfix/TAN-####[-...]   (bugfix/ also allowed)"
      echo "  Examples:  feature/TAN-4418-dealer-sales-performance-reports"
      echo "             feature/TAN-4418   (description optional — also valid)"
      echo ""
      echo "  Fix:  git branch -m \"$BRANCH\" feature/TAN-####-short-description"
      echo "  To bypass (not recommended): git push --no-verify"
      echo ""
      exit 1
    fi
    ;;
esac
# --- end branch guard ---

PATTERN='^TAN-[0-9]+:'
FAIL=0

# stdin lines: <local-ref> <local-sha> <remote-ref> <remote-sha>
# We validate ONLY the commits between the remote tip and what we are pushing.
REMOTESHA=""
LOCALSHA=""
while read -r LREF LSB LREF_R RSHA; do
  # Delete-only push: nothing to validate
  [ "$LSB" = "0000000000000000000000000000000000000000" ] && exit 0
  LOCALSHA="$LSB"
  # If pushing a new remote branch, the remote sha is zeros; fall back to
  # "commits not reachable from any existing remote branch".
  if [ "$RSHA" = "0000000000000000000000000000000000000000" ]; then
    REMOTESHA=""
  else
    REMOTESHA="$RSHA"
  fi
done

if [ -z "$LOCALSHA" ]; then
  # No stdin received (mismatched git version) — do nothing rather than guess
  exit 0
fi



if [ -n "$REMOTESHA" ]; then
  LOCAL_COMMITS=$(git log --first-parent "${REMOTESHA}..${LOCALSHA}" --pretty=format:"%H %s" --no-merges 2>/dev/null)
else
  # New branch: only commits not already on any remote branch
  LOCAL_COMMITS=$(git log --first-parent "$LOCALSHA" --not --remotes --pretty=format:"%H %s" --no-merges 2>/dev/null)
fi

if [ -z "$LOCAL_COMMITS" ]; then
  exit 0
fi

while IFS= read -r line; do
  SHA=$(echo "$line" | cut -d' ' -f1)
  MSG=$(echo "$line" | cut -d' ' -f2-)

  # Skip merges/reverts
  case "$MSG" in
    "Merge "*|"Revert "*) continue ;;
  esac

  if echo "$MSG" | grep -qE "$PATTERN"; then
    continue
  fi

  echo "  FAIL $(git rev-parse --short "$SHA" 2>/dev/null || echo "${SHA:0:7}")  $MSG"
  FAIL=1
done <<< "$LOCAL_COMMITS"

if [ "$FAIL" -eq 1 ]; then
  echo ""
  echo "Push blocked. Every commit must start with TAN-####: (e.g. TAN-3964: Fix login button)"
  echo "Use: git commit --amend  or  git rebase -i  to fix commit messages."
  echo "To bypass (not recommended): git push --no-verify"
  exit 1
fi
